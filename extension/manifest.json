{
  "manifest_version": 3,
  "name": "Pilcrino",
  "version": "0.63.0",
  "description": "Reads Google search results for Pilcrino, in this browser, on request. Touches no other page.",
  "key": "",
  "permissions": ["tabs", "alarms"],
  "host_permissions": ["https://www.google.com/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://www.google.com/search*"], "js": ["lib/read-serp.js", "content.js"], "run_at": "document_idle" }
  ]
}
